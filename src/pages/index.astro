---
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import PageHero from '../components/PageHero.astro';
import EmptyState from '../components/EmptyState.astro';
import { getDatabase } from '../lib/db';
import { getAllCategories, getAllGames, getAllPublishers } from '../lib/games';

export const prerender = true;

const categories = await getAllCategories(getDatabase());
const publishers = await getAllPublishers(getDatabase());
const games = await getAllGames(getDatabase());
---

<Layout title="Tailspin Toys - Crowdfunding your new favorite game!">
  <div class="py-8">
    <PageHero
      title="Welcome to Tailspin Toys"
      subtitle="Find your next game! And maybe even back one! Explore our collection!"
    />

    <div class="mb-8 rounded-xl border border-slate-700 bg-slate-800/80 p-5 shadow-lg" data-testid="game-filters">
      <form method="get" class="space-y-4" data-testid="game-filters-form">
        <div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
          <fieldset class="flex-1">
            <legend class="mb-3 text-sm font-medium uppercase tracking-wide text-slate-300">Filter by category</legend>
            <div class="flex flex-wrap gap-3">
              {categories.map((category) => (
                <label
                  class="inline-flex items-center gap-2 rounded-lg border border-slate-600 bg-slate-900/70 px-3 py-2 text-sm text-slate-200 transition-colors hover:border-blue-400"
                  data-testid={`category-filter-label-${category.id}`}
                >
                  <input
                    type="checkbox"
                    name="category"
                    value={String(category.id)}
                    aria-label={`Filter by ${category.name}`}
                    data-testid={`category-filter-${category.id}`}
                    class="h-4 w-4 accent-blue-500"
                  />
                  <span>{category.name}</span>
                </label>
              ))}
            </div>
          </fieldset>

          <div class="lg:w-72">
            <label for="publisher-filter" class="mb-2 block text-sm font-medium uppercase tracking-wide text-slate-300">
              Publisher
            </label>
            <select
              id="publisher-filter"
              name="publisher"
              data-testid="publisher-filter"
              aria-label="Filter games by publisher"
              class="w-full rounded-lg border border-slate-600 bg-slate-900 px-3 py-2 text-slate-100 shadow-sm focus:border-blue-500 focus:ring-2 focus:ring-blue-500 focus:outline-none"
            >
              <option value="">All publishers</option>
              {publishers.map((publisher) => (
                <option value={String(publisher.id)}>{publisher.name}</option>
              ))}
            </select>
          </div>
        </div>

        <div class="flex flex-wrap items-center gap-3">
          <button
            type="submit"
            data-testid="apply-filters"
            class="inline-flex items-center justify-center rounded-lg bg-blue-600 px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-blue-500 focus:ring-2 focus:ring-blue-500 focus:outline-none"
          >
            Apply filters
          </button>

          <a
            href="/"
            data-testid="clear-filters"
            class="inline-flex items-center justify-center rounded-lg border border-slate-600 px-4 py-2 text-sm font-medium text-slate-200 transition-colors hover:border-blue-400 hover:text-blue-400 focus:ring-2 focus:ring-blue-500 focus:outline-none"
          >
            Clear filters
          </a>
        </div>
      </form>
    </div>

    <div>
      <h2 class="text-2xl font-medium mb-6 text-slate-100">Featured Games</h2>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6" data-testid="games-grid">
        {games.map((game) => <GameCard game={game} />)}
      </div>

      <div data-testid="empty-state-wrapper" hidden>
        <EmptyState text="No games match the selected filters." />
      </div>
    </div>
  </div>

  <script is:inline>
    const filterForm = document.querySelector('[data-testid="game-filters-form"]');
    const gameCards = [...document.querySelectorAll('[data-testid="game-card"]')];
    const gamesGrid = document.querySelector('[data-testid="games-grid"]');
    const emptyStateWrapper = document.querySelector('[data-testid="empty-state-wrapper"]');

    function applyFilters() {
      const selectedCategories = [...document.querySelectorAll('input[name="category"]:checked')].map((input) => input.value);
      const selectedPublisher = document.querySelector('[data-testid="publisher-filter"]').value;
      let visibleCount = 0;

      gameCards.forEach((card) => {
        const categoryMatches = selectedCategories.length === 0 || selectedCategories.includes(card.dataset.categoryId || '');
        const publisherMatches = selectedPublisher === '' || card.dataset.publisherId === selectedPublisher;
        const isVisible = categoryMatches && publisherMatches;

        card.hidden = !isVisible;
        if (isVisible) {
          visibleCount += 1;
        }
      });

      if (gamesGrid) {
        gamesGrid.hidden = visibleCount === 0;
      }

      if (emptyStateWrapper) {
        emptyStateWrapper.hidden = visibleCount !== 0;
      }
    }

    if (filterForm) {
      filterForm.addEventListener('submit', (event) => {
        event.preventDefault();
        applyFilters();
      });
    }

    document.querySelectorAll('input[name="category"], [data-testid="publisher-filter"]').forEach((input) => {
      input.addEventListener('change', applyFilters);
    });

    applyFilters();
  </script>
</Layout>
